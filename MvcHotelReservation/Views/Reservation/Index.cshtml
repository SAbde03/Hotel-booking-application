@model IEnumerable<MvcHotelReservation.Models.Reservation>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html lang="">
<head>
    <link rel="stylesheet" href="/css/CartStyle.css">
    <title></title>
</head>
<section>
<table class="table" style="table-border-color-dark: #1a1e21">
    <thead>
    <tr>

        <th>
           Ckeckin
        </th>
        <th>
            Checkout        
            </th>
        <th>
            @Html.DisplayNameFor(model => model.Statut)
        </th>
        <th>
            Total
        </th>
        <th>
            ReservationDate
        </th>
        <th>
           Category
        </th>
        <th>
          
        </th>
    </tr>

    <tbody>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @Html.DisplayFor(modelItem => item.DateDebut)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateFin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Statut)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MontantTotal) MAD
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateReservation)
            </td>
            <td>
                @Html.DisplayFor(model => item.Chambre.TypeChambre)
            </td>
            <td id="deteleCell">
                <!-- <a asp-action="Edit" asp-route-id="@item.IdReservation">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdReservation">Details</a> -->
                <a asp-action="Delete" asp-route-id="@item.IdReservation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="black" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                    </svg></a>
            </td>
        </tr>
    }
    </tbody>

</table>
</section>
</html>