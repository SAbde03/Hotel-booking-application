@model IEnumerable<MvcHotelReservation.Models.Reservation>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html lang="">
<head>
    <link rel="stylesheet" href="/css/CartStyle.css">
    <title></title>
</head>
<section>
<table class="table" style="table-border-color-dark: #1a1e21">
    <thead>
    <tr>

        <th>
           Ckeckin
        </th>
        <th>
            Checkout        
            </th>
        <th>
            @Html.DisplayNameFor(model => model.Statut)
        </th>
        <th>
            Total
        </th>
        <th>
            ReservationDate
        </th>
        <th>
           Category
        </th>
        
    </tr>

    <tbody>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @Html.DisplayFor(modelItem => item.DateDebut)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateFin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Statut)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MontantTotal) MAD
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateReservation)
            </td>
            <td>
                @Html.DisplayFor(model => item.Chambre.TypeChambre)
            </td>
           
            <td id="deteleCell">
                <!-- <a asp-action="Edit" asp-route-id="@item.IdReservation">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdReservation">Details</a> -->
                @if (item.DateFin > DateTime.Now && item.Statut=="Confirmed")
                {
                    <a asp-action="Delete" asp-route-id="@item.IdReservation">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="black" class="bi bi-x" viewBox="0 0 16 16">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                        </svg></a>
                }
            </td>
        </tr>
    }
    </tbody>

</table>
</section>
</html>