@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Marriott</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Visualisation.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="e1786e79b5287e0d6bca2104a8540e5a.ico" />
    <link rel="stylesheet" href="~/MvcHotelReservation.styles.css" asp-append-version="true" />
</head>
<body>

<header>
    
    <nav class="navbar">
        <div class="container">
            <div class="navbar-brand">
                <a asp-controller="Home" asp-action="Index">
                    <img src="/images/logo.png" alt="Hotel Reservation">
                </a>
                <div class="Vline"></div>
                <img src="/images/Marriott-International-Logo-500x281.png" class="des" alt="Hotel Reservation">

            </div>
            <div class="navbar-collapse" id="navbarNav">
                <ul class="navbar-nav list">
                    @if (HttpContextAccessor.HttpContext.Session.GetString("FullName") == null)
                    {
                        <!-- Show Sign In / Sign Up -->
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <button onclick="openPopup('login')">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                                    </svg>
                                    <span>Sign In / Sign Up</span>
                                </button>
                            </a>
                        </li>
                    }
                    else
                    {
                        <!-- Show User Profile -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Profil">
                                <img src="@HttpContextAccessor.HttpContext.Session.GetString("imagePath")" alt="User Profile" class="profile-icon">
                                <span>Mr @HttpContextAccessor.HttpContext.Session.GetString("FullName")</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <!-- PopUp -->
        <div class="overlay" id="overlay"></div>

        <div class="popup" id="popup">

            <div class="popup-header">
                <h2 id="popup-title">Login</h2>
            </div>
            <div class="popup-content" id="popup-content">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    </div>
                }
                <!-- Login Form -->
                <form id="login-form" method="post" asp-controller="Account" asp-action="Login">
                    <input name="email" type="email" placeholder="Email" required>
                    <input name="password" type="password" placeholder="Password" required>
                    <button type="submit">Login</button>
                </form>
                <!-- Sign-Up Form -->
                <form id="signup-form" style="display: none;  "asp-action="signUp" asp-controller="Account" method="post">
                    <input for="nom" type="text" placeholder="Nom" required>
                    <input for="prenom" type="text" placeholder="Prenom" required>
                    <input for="email" type="email" placeholder="email" required>
                    <input for="motDePasse" type="password" placeholder="Password" required>
                    <input for="telephone" type="text" placeholder="Phone number" required>
                    <button type="submit">Sign Up</button>
                </form>
            </div>
            <div class="popup-footer">
                <span id="toggle-link">Don't have an account? <a onclick="toggleForm()">Sign Up</a></span>
            </div>
        </div>
    </nav>
</header>

<main >
    @RenderBody()
</main>


@await RenderSectionAsync("Scripts", required: false)
<footer>
    <div class="footer-title-wrapper">
        <hr>
        <img src="/images/MAR-5124f716.png" alt="Hotel Reservation">
        <hr>
    </div>

    <div class="footer-content-wrapper">
        <div class="social-logos-wrapper">
            <a href="#">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="black" class="bi bi-facebook" viewBox="0 0 16 16">
                    <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"/>
                </svg></a>
            <a href="#">
