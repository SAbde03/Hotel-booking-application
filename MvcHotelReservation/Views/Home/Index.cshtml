@{
    ViewData["Title"] = "Welcome to Our Hotel";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Reservation - Welcome</title>
    <link rel="stylesheet" href="css/site.css"/>
    <style>
        .section {
            background:linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),url("./images/B6911_~2_13by5.jpg") no-repeat center center/cover;
            background-size: cover;
            background-position: center;
            background-opacity: 0.5;
            color: white;
            text-align: center;
            padding: 4rem 0;
            height: 100%;
            height: 500px;
            
        }
        
    </style>
</head>
<body>
    
<nav class="navbar">
    <div class="band">
        <div class="line">Loyalty</div>
        <div class="line">Service quality</div>
        <div class="line">Loyalty</div>
        <div class="line">Transparency</div>
    </div>
    <div class="container">
        <div class="navbar-brand">
            <img src="images/logo.png"  alt="Hotel Reservation">
            <div class="Vline"></div>
            <img src="/images/Marriott-International-Logo-500x281.png" class="des" alt="Hotel Reservation">
    </div>
        <div class="navbar-collapse" id="navbarNav">
            <ul class="navbar-nav list">
                <li class="nav-item"><a class="nav-link" href="#"><button><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                </svg> <span>Sign In / Sign Up</span></button></a></li>
            </ul>
        </div>
    </div>
</nav>

   
    <section class="section">
        <div class="content">
            <h1 class="">Welcome to the Hotel Family</h1>
            <p class="lead">You came here for a reason.</p>

           
            <div class="container-search-box">
                <form>
                    <div class="search-box-inputs">
                        <div class="grids">
                            <label for="destination" class="form-label">Where do you want to travel?</label>
                            <input type="text" class="form-control" id="destination" placeholder="Destination, hotel name">
                        </div>
                        <div class="grids">
                            <label for="checkin" class="form-label">Check-In</label>
                            <input type="date" class="form-control" id="checkin">
                        </div>
                        <div class="grids">
                            <label for="checkout" class="form-label">Check-Out</label>
                            <input type="date" class="form-control" id="checkout">
                        </div>
                        <div class="grids">
                            <label for="guests" class="form-label">Rooms & Guests</label>
                            <select id="guests" class="form-select">
                                <option selected>1 Room(s) - 1 Guest(s)</option>
                                <option>2 Room(s) - 2 Guest(s)</option>
                                <option>3 Room(s) - 3 Guest(s)</option>
                            </select>
                        </div>
                        <div class="search-btn">
                            <button type="submit" class="submit">Search</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        
    </section>

<div class="Container-2">
    <div class="section-title-wrapper">
        <hr>
        <h3 class="section-title">Types of Rooms</h3>
        <hr>
    </div>
    <div class="rooms-grid">
        <!-- Room 1 -->
        <div class="room-card">
            <img src="images/atr.royalmansion-majlis-mr.jpg" alt="Deluxe Room">
            <h3>Deluxe Room</h3>
            <p>A spacious room with modern amenities, perfect for a comfortable stay. Starting at $150/night.</p>
            <button>View Details</button>
        </div>

        <!-- Room 2 -->
        <div class="room-card">
            <img src="images/the-amayaa.jpg" alt="Suite">
            <h3>Suite</h3>
            <p>Experience luxury with separate living areas, ideal for families or special occasions. Starting at $300/night.</p>
            <button>View Details</button>
        </div>

        <!-- Room 3 -->
        <div class="room-card">
            <img src="images/room_standard_1.jpg" alt="Standard Room">
            <h3>Standard Room</h3>
            <p>A cozy and affordable option with all the essentials for a pleasant stay. Starting at $100/night.</p>
            <button>View Details</button>
        </div>
    </div>
</div>


<footer>
    <div class="footer-title-wrapper">
        <hr>
        <img src="images/MAR-5124f716.png" alt="Hotel Reservation">
        <hr>
    </div>
    <div>
        <!-- About Section -->
        <h3>About Us</h3>
        <p>We are dedicated to providing the best hospitality experience. Your comfort and satisfaction are our top priorities.</p>
    </div>

    <div>
        
        
        
    </div>

    <div>
        <!-- Contact Section -->
        <h3>Contact Us</h3>
        <ul>
            <li>Av Moulay Hassan, Marrackech, Morocco</li>
            <li>+212 556 7890</li>
            <li>mariotte@hotelreservation.com</li>
        </ul>
        <!-- Social Links -->
        <div>
            <a href="#">Facebook</a> |
            <a href="#">Twitter</a> |
            <a href="#">Instagram</a>
        </div>
    </div>

    <div>
        <!-- Copyright -->
        <p>&copy; 2024 Hotel Reservation. All Rights Reserved.</p>
    </div>
</footer>

    
    
</body>
</html>
