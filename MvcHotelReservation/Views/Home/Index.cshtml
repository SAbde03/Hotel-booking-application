@{
    ViewData["Title"] = "Welcome to Our Hotel";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Reservation - Welcome</title>
    <link rel="stylesheet" href="css/site.css"/>
    <style>
        .section {
            background:linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),url("./images/B6911_~2_13by5.jpg") no-repeat center center/cover;
            background-size: cover;
            background-position: center;
            background-opacity: 0.5;
            color: white;
            text-align: center;
            padding: 4rem 0;
            height: 100%;
            height: 500px;
            
        }
        
    </style>
</head>
<body>


<nav class="navbar">
    <div class="band">
        <div class="line">Loyalty</div>
        <div class="line">Service quality</div>
        <div class="line">Loyalty</div>
        <div class="line">Transparency</div>
    </div>
    <div class="container">
        <div class="navbar-brand">
            <img src="images/logo.png" alt="Hotel Reservation">
            <div class="Vline"></div>
            <img src="/images/Marriott-International-Logo-500x281.png" class="des" alt="Hotel Reservation">
        </div>
        <div class="navbar-collapse" id="navbarNav">
            <ul class="navbar-nav list">
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <button onclick="openPopup()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                            </svg> <span>Sign In / Sign Up</span></button></a></li>
            </ul>
        </div>
    </div>
    <!-- PopUp -->
    <div class="overlay" id="overlay"></div>

    <div class="popup" id="popup">

        <div class="popup-header">
            <h2 id="popup-title">Login</h2>
        </div>
        <div class="popup-content" id="popup-content">
            <!-- Login Form -->
            <form id="login-form">
                <input type="email" placeholder="Email" required>
                <input type="password" placeholder="Password" required>
                <button type="submit">Login</button>
            </form>
            <!-- Sign-Up Form -->
            <form id="signup-form" style="display: none;">
                <input type="text" placeholder="Full Name" required>
                <input type="email" placeholder="Email" required>
                <input type="password" placeholder="Password" required>
                <button type="submit">Sign Up</button>
            </form>
        </div>
        <div class="popup-footer">
            <span id="toggle-link">Don't have an account? <a onclick="toggleForm()">Sign Up</a></span>
        </div>
    </div>
</nav>


<section class="section">
    <div class="content">
        <h1 class="">Welcome to the Hotel Family</h1>
        <p class="lead">You came here for a reason.</p>


        <div class="container-search-box">
            <form>
                <div class="search-box-inputs">
                    <div class="grids">
                        <label for="destination" class="form-label">Where do you want to book?</label>
                        <input type="text" class="form-control" id="destination" placeholder="Destination, hotel name">
                    </div>
                    <div class="grids">
                        <label for="checkin" class="form-label">Check-In</label>
                        <input type="date" class="form-control" id="checkin">
                    </div>
                    <div class="grids">
                        <label for="checkout" class="form-label">Check-Out</label>
                        <input type="date" class="form-control" id="checkout">
                    </div>
                    <div class="grids">
                        <label for="guests" class="form-label">Rooms & Guests</label>
                        <select id="guests" class="form-select">
                            <option selected>1 Room(s) - 1 Guest(s)</option>
                            <option>2 Room(s) - 2 Guest(s)</option>
                            <option>3 Room(s) - 3 Guest(s)</option>
                        </select>
                    </div>
                    <div class="search-btn">
                        <button type="submit" class="submit">Search</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

</section>

<div class="Container-2">
    <div class="section-title-wrapper">
        <hr>
        <h3 class="section-title">Discover</h3>
        <hr>
    </div>
    <section class="rooms-grid">
        <!-- Room 1 -->
        <div class="room-card">
            <img src="images/atr.royalmansion-majlis-mr.jpg" alt="Deluxe Room">
            <h3>Deluxe Room</h3>
            <p>A spacious room with modern amenities, perfect for a comfortable stay. Starting at $150/night.</p>
            <button>View Details</button>
        </div>

        <!-- Room 2 -->
        <div class="room-card">
            <img src="images/the-amayaa.jpg" alt="Suite">
            <h3>Suite</h3>
            <p>Experience luxury with separate living areas, ideal for families or special occasions. Starting at $300/night.</p>
            <button>View Details</button>
        </div>

        <!-- Room 3 -->
        <div class="room-card">
            <img src="images/room_standard_1.jpg" alt="Standard Room">
            <h3>Standard Room</h3>
            <p>A cozy and affordable option with all the essentials for a pleasant stay. Starting at $100/night.</p>
            <button>View Details</button>
        </div>

    </section>
</div>


<footer>
    <div class="footer-title-wrapper">
        <hr>
        <img src="images/MAR-5124f716.png" alt="Hotel Reservation">
        <hr>
    </div>

    <div class="footer-content-wrapper">
        <div class="social-logos-wrapper">
            <a href="#">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="black" class="bi bi-facebook" viewBox="0 0 16 16">
                    <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"/>
                </svg></a>
            <a href="#">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="black" class="bi bi-twitter-x" viewBox="0 0 16 16">
                    <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
                </svg></a>
            <a href="#">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="black" class="bi bi-instagram" viewBox="0 0 16 16">
                    <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
                </svg></a>
        </div>
        <h3>About Us</h3>
        <p>We are dedicated to providing the best hospitality experience. Your comfort and satisfaction are our top priorities.</p>


        <div class="contact-us">

            <h3>Contact Us</h3>
            <p>
                Av Moulay Hassan, Marrackech, Morocco <br/><br/> +212 556 7890 <br/> <br/> mariotte@hotelreservation.com
            </p>
            <!-- Social Links -->

        </div>

        <div>
            <!-- Copyright -->
            <p>&copy; 2024 Hotel Reservation. All Rights Reserved.</p>
        </div>
    </div>
</footer>


<script src="JavaScript/home.js"></script>
</body>
</html>
