@model List<MvcHotelReservation.Models.Chambre>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/Index.css"/>
    <title>Mariotte</title>
    
</head>
<body>
<style>
    
    .section{
        height: 100px;
        margin-bottom: 100px;
    }
    .search-box-inputs .grids select{
       
        height: 100%;
    }
    .search-box-inputs .grids input {
        width:250px;
        height: 90%;
    }
    .section .content{
        padding-top: 0px;
        width: 100%;
        background-color: white;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        height: fit-content;
    }
    .container-search-box {
        margin-top: 0px;
        position: relative;
        background-color: rgba(255, 255, 255);
        padding: 2rem;
        border-radius: 0px;
        box-shadow: 0 0px 0px rgba(1, 1, 1, 1);
        width:fit-content;
        top: 0px;
        margin: 0 auto;
        align-items: center;
        align-content: space-around;
    }
    .detailsbtn{
        display: flex;
    }
    .detailsbtn .favoris{
        border-radius: 50%;
        height: 30px;
        width: 30px;
        margin-top: 60px;
        margin-left: 20px;
        background-color: white;
        border: solid 0.1px #d6d6d6;
    }
    .favoris svg {
        margin-right: 0px;
        padding-right: 0px;
        margin-left: 0px;
        width: 21px;
        height: 21px;
        padding-top: 5px;
    }
    .price h5{
        font-family: font5;
        padding-top: 11px;
        font-size: 10px;
    }

</style>
<section class="path"><a asp-controller="Home" asp-action="Index">home</a>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="10" fill="currentColor" class="bi bi-chevron-right" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
    </svg><a asp-controller="Chambre" asp-action="Index"><b>Explore</b></a>
</section>
<section class="section">
    <div class="content">
        <div class="container-search-box">
            <form asp-controller="Chambre" asp-action="Index"  method="post">
                <div class="search-box-inputs">
                    <div class="grids">
                        <label for="destination" class="form-label">Where do you want to book ?</label>
                        <input type="text" class="form-control" id="destination" placeholder="Destination, hotel name" required="">
                    </div>
                    <div class="grids">
                        <label for="checkin" class="form-label">Check-In</label>
                        <input name="checkin" type="date" class="form-control" id="checkin" required="">
                    </div>
                    <div class="grids">
                        <label for="checkout" class="form-label">Check-Out</label>
                        <input name="checkout" type="date" class="form-control" id="checkout" required="">
                    </div>
                    <div class="grids">
                        <label for="guests" class="form-label">Rooms & Guests</label>
                        <select name="capacity" id="type" class="form-select">
                            <option value="0">--</option>
                            <option value="1">1 guest</option>
                            <option value="2">2 guests</option>
                            <option value="3">3 guests</option>
                            <option value="4">4 guests</option>
                            <option value="5">+ 5 guests</option>
                        </select>
                    </div>
                    <div class="search-btn">
                        <button type="submit" class="submit">Search</button>

                    </div>
                </div>
            </form>
        </div>
    </div>

</section>

<div class="sections-container">
    @foreach (var item in Model)
    {
        <div class="sections">

            <div class="left">
                <div class="img-container">
                    <img src="@Html.DisplayFor(model => item.ImagePath)"/>
                </div></div>
            <div class="right">
                <div class="title">
                    <h2>@Html.DisplayFor(model => item.TypeChambre)</h2>
                </div>

                <p>@Html.DisplayFor(model => item.Description)</p>
                <div class="price">
                    <h2 id="price">@Html.DisplayFor(model => item.PrixParNuit)</h2>
                    <h5>MAD</h5></div>

            </div>
            <div class="detailsbtn">
                <a asp-controller="Chambre" asp-action="Details" asp-route-id="@item.IdChambre" method="GET"><button class="details">Details</button></a>
                <button class="favoris"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="black" class="bi bi-star" viewBox="0 0 16 16">
                        <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.56.56 0 0 0-.163-.505L1.71 6.745l4.052-.576a.53.53 0 0 0 .393-.288L8 2.223l1.847 3.658a.53.53 0 0 0 .393.288l4.052.575-2.906 2.77a.56.56 0 0 0-.163.506l.694 3.957-3.686-1.894a.5.5 0 0 0-.461 0z"/>
                    </svg></button>
            </div>
            <!--<p id="dispo">20 chambres disponibles</p>-->


        </div>
    }
</div>
</body>
</html>